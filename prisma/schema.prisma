generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int     @id @default(autoincrement())
  name     String?  
  homeCity String?
  visits   Visit[]
}

model Visit {
  id        Int      @id @default(autoincrement())
  city      String
  arriveAt  DateTime @db.Date
  departAt  DateTime @db.Date
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}
