generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int     @id @default(autoincrement())
  name     String?  
  homeCity String?
  instagramHandle String? 
  visits   Visit[]
}

model Visit {
  id        Int      @id @default(autoincrement())
  description String?
  locationId Int
  arriveAt  DateTime @db.Date
  departAt  DateTime @db.Date
  userId    Int
  location  Location @relation(fields: [locationId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Location {
  id        Int      @id @default(autoincrement())
  city      String   @unique
  visits    Visit[]
}
